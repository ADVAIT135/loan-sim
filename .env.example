# Example environment variables for Netlify functions
# Set either AUDIT_PROXY_URL or SUPABASE_URL + SUPABASE_SERVICE_ROLE

# Absolute URL to audit proxy lambda (Netlify function or external endpoint)
AUDIT_PROXY_URL=https://your-site.netlify.app/.netlify/functions/auditProxy

# Supabase direct write config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=your-service-role-key
